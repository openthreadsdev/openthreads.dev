{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && vite build && npm run prerender",
    "build:dev": "vite build --mode development",
    "prerender": "tsx scripts/prerender-meta-tags.ts",
    "lint": "eslint . && npm run lint:spelling",
    "lint:spelling": "tsx scripts/check-british-spelling.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "preview": "vite preview",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke": "npm run build && playwright test --config=playwright.config.prod.ts",
    "prepare": "husky"
  },
