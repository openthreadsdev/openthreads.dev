c/components/resources/CompareModal.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/CompareTable.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ConditionFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Pagination.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/PriceRange.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/PriceRangeSlider.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/QuickView.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Rating.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ResourceDetails.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ResourceTab.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ResourcesFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Search.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ShowSelect.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SidebarIcon.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SingleResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SingleResourceList.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SizeFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SortSelect.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Tags.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/WishlistModal.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/fetchSlider.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/storage-wrapper.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Brand.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Category.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/FeaturedResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/HomeSlider.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Related.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/RelatedResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Special.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Thumb.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/api.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/filterProduct.ts",["593"],[],"// Filter Products By Filters\n\nexport default (productList, filters) => {\n  let filteredList = [...productList];\n\n  for (const key in filters) {\n    if (key !== 'price') {\n      if (\n        filters[key] === 'featured' ||\n        filters[key] === 'trending' ||\n        filters[key] === 'lowToHigh' ||\n        filters[key] === 'highToLow'\n      ) {\n        if (filters[key] === 'lowToHigh') {\n          filteredList = [\n            ...filteredList.sort((a, b) => {\n              if (a.price < b.price) return -1;\n              if (a.price > b.price) return 1;\n              return 1;\n            }),\n          ];\n        } else {\n          if (filters[key] === 'highToLow') {\n            console.log('hi');\n            filteredList = [\n              ...filteredList.sort((a, b) => {\n                if (b.price < a.price) return -1;\n                if (b.price > a.price) return 1;\n                return 1;\n              }),\n            ];\n          } else {\n            console.log('hi1');\n            filteredList = filteredList.filter((item) => item[filters[key]]);\n          }\n        }\n      } else {\n        filteredList = filterByKey(filteredList, filters[key], key);\n      }\n    } else {\n      filteredList = filterByPrice(filteredList, filters[key], key);\n    }\n  }\n  return filteredList;\n};\n\n// Filter Product By Price\n\nfunction filterByPrice(filteredList, price, key) {\n  let list: any[] = [];\n\n  for (let index = 0; index < filteredList.length; index++) {\n    const product = filteredList[index];\n    const productPrice = product[key];\n\n    if (productPrice >= price.min && productPrice <= price.max) {\n      list.push(product);\n    }\n  }\n\n  return (filteredList = list);\n}\n\n// Filter Product by key size/category/brand etc\n\nfunction filterByKey(filteredList, size, key) {\n  let list: any[] = [];\n  if (!size || size.length === 0) return filteredList;\n  for (let index = 0; index < filteredList.length; index++) {\n    const product = filteredList[index];\n\n    if (size.indexOf != undefined) {\n      const isOk = size && size.indexOf(product[key]);\n      if (isOk !== -1) {\n        list.push(product);\n      }\n    }\n  }\n\n  return (filteredList = list);\n}\n","/Users/kahboom/Projects/thetextilecode.com/src/lib/filterResource.ts",["594"],[],"// Filter Resources By Filters\n\nexport default (resourceList, filters) => {\n  let filteredList = [...resourceList];\n\n  for (const key in filters) {\n    if (key !== 'price') {\n      if (\n        filters[key] === 'featured' ||\n        filters[key] === 'trending' ||\n        filters[key] === 'lowToHigh' ||\n        filters[key] === 'highToLow'\n      ) {\n        if (filters[key] === 'lowToHigh') {\n          filteredList = [\n            ...filteredList.sort((a, b) => {\n              if (a.price < b.price) return -1;\n              if (a.price > b.price) return 1;\n              return 1;\n            }),\n          ];\n        } else {\n          if (filters[key] === 'highToLow') {\n            console.log('hi');\n            filteredList = [\n              ...filteredList.sort((a, b) => {\n                if (b.price < a.price) return -1;\n                if (b.price > a.price) return 1;\n                return 1;\n              }),\n            ];\n          } else {\n            console.log('hi1');\n            filteredList = filteredList.filter((item) => item[filters[key]]);\n          }\n        }\n      } else {\n        filteredList = filterByKey(filteredList, filters[key], key);\n      }\n    } else {\n      filteredList = filterByPrice(filteredList, filters[key], key);\n    }\n  }\n  return filteredList;\n};\n\n// Filter Resource By Price\n\nfunction filterByPrice(filteredList, price, key) {\n  let list: any[] = [];\n\n  for (let index = 0; index < filteredList.length; index++) {\n    const resource = filteredList[index];\n    const resourcePrice = resource[key];\n\n    if (resourcePrice >= price.min && resourcePrice <= price.max) {\n      list.push(resource);\n    }\n  }\n\n  return (filteredList = list);\n}\n\n// Filter Resource by key size/category/brand etc\n\nfunction filterByKey(filteredList, size, key) {\n  let list: any[] = [];\n  if (!size || size.length === 0) return filteredList;\n  for (let index = 0; index < filteredList.length; index++) {\n    const resource = filteredList[index];\n\n    if (size.indexOf != undefined) {\n      const isOk = size && size.indexOf(resource[key]);\n      if (isOk !== -1) {\n        list.push(resource);\n      }\n    }\n  }\n\n  return (filteredList = list);\n}\n","/Users/kahboom/Projects/thetextilecode.com/src/lib/fonts.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/localStorage.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/mdxUtils.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/outsideClick.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/searchItemsByText.ts",["595"],[],"export default (searchTerm, products) => {\n  if (!searchTerm) return products;\n\n  let list: any[] = [];\n  const words = searchTerm.toLowerCase().split(' ');\n\n  for (let index = 0; index < products.length; index++) {\n    const product = products[index];\n    const isMatched = matchWordList(product.title, words);\n    if (isMatched) list.push(product);\n  }\n\n  return list;\n};\n\nconst matchWordList = (productTitle, words) => {\n  let matched = false;\n\n  for (let index = 0; index < words.length; index++) {\n    const word = words[index];\n    let isContainWord = productTitle.toLowerCase().indexOf(word) !== -1;\n    isContainWord ? (matched = true) : (matched = false);\n    if (!isContainWord) break;\n  }\n  return matched;\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/lib/util.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/cart.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/compareAction.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/product.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/productFiltersAction.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/quickViewAction.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/resource.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/resourceFiltersAction.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/action/wishlistAction.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/constants/actionTypes.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/cart.ts",["596"],[],"import storage from '../../lib/localStorage';\nimport { deleteProduct, findProductIndexById } from '../../lib/util';\nimport * as Types from '../constants/actionTypes';\n\nexport default (state: any[] = [], action) => {\n  let index: number = -1;\n\n  switch (action.type) {\n    case Types.INIT_LOCALSTORAGE:\n      return [...action.payload.cart];\n\n    case Types.ADD_TO_CART:\n      index = findProductIndexById(state, action.payload.product.id);\n\n      if (index !== -1) {\n        state[index].quantity += 1;\n        storage.set('dokani_cart', [...state]);\n\n        return [...state];\n      } else {\n        if (!action.payload.product.quantity) {\n          action.payload.product.quantity = 1;\n        }\n        storage.set('dokani_cart', [...state, action.payload.product]);\n\n        return [...state, action.payload.product];\n      }\n\n    case Types.DELETE_FROM_CART:\n      const newCartItems = deleteProduct(state, action.payload.productId);\n      storage.set('dokani_cart', newCartItems);\n\n      return [...newCartItems];\n\n    case Types.INCREASE_QUANTITY:\n      index = findProductIndexById(state, action.payload.productId);\n      if (index === -1) return state;\n\n      state[index].quantity += 1;\n      storage.set('dokani_cart', [...state]);\n\n      return [...state];\n\n    case Types.DECREASE_QUANTITY:\n      index = findProductIndexById(state, action.payload.productId);\n      if (index === -1) return state;\n\n      const quantity = state[index].quantity;\n      if (quantity > 1) state[index].quantity -= 1;\n      storage.set('dokani_cart', [...state]);\n\n      return [...state];\n\n    case Types.CLEAR_CART:\n      storage.set('dokani_cart', []);\n      return [];\n\n    default:\n      return state;\n  }\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/compare.ts",["597"],[],"import * as Types from '../constants/actionTypes';\nimport { deleteProduct, findProductIndexById } from '../../lib/util';\nimport storage from '../../lib/localStorage';\n\nconst initialState = {\n  modal: false,\n  items: [],\n};\n\nexport default (state = initialState, action) => {\n  let index = null;\n\n  switch (action.type) {\n    case Types.OPEN_COMPARE:\n      return {\n        ...state,\n        modal: true,\n      };\n\n    case Types.CLOSE_COMPARE:\n      return {\n        ...state,\n        modal: false,\n      };\n\n    case Types.INIT_LOCALSTORAGE:\n      return {\n        ...state,\n        items: [...action.payload.compare],\n      };\n\n    case Types.ADD_TO_COMPARE:\n      index = findProductIndexById(state.items, action.payload.product.id);\n      if (index !== -1) return state;\n\n      const items = [...state.items, action.payload.product];\n\n      storage.set('dokani_compare', items);\n\n      return {\n        ...state,\n        items,\n      };\n\n    case Types.DELETE_FROM_COMPARE:\n      const list = deleteProduct(state.items, action.payload.productId);\n      storage.set('dokani_compare', list);\n\n      return {\n        ...state,\n        items: [...list],\n      };\n\n    case Types.CLEAR_COMPARE:\n      storage.set('dokani_compare', []);\n\n      return {\n        ...state,\n        items: [],\n      };\n\n    default:\n      return state;\n  }\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/product.ts",["598"],[],"import { deleteProduct, findProductIndexById } from '../../lib/util';\nimport * as Types from '../constants/actionTypes';\n\n// {items:[],filteredList:[]}\n\nexport default (state = { items: [] }, action) => {\n  switch (action.type) {\n    case Types.FETCHED_PRODUCT:\n      return {\n        ...state,\n        items: [...action.payload.products],\n      };\n\n    case Types.FETCHED_MORE_PRODUCT:\n      const mergeAllProducts = [\n        ...state.items,\n        ...action.payload.products,\n      ];\n      // console.log(mergeAllProducts);\n      const limit =\n        action.payload.total &&\n        mergeAllProducts.length > action.payload.total\n          ? mergeAllProducts.splice(0, action.payload.total)\n          : mergeAllProducts;\n\n      return {\n        ...state,\n        items: [...limit],\n      };\n\n    case Types.ADD_PRODUCT:\n      return {\n        ...state,\n        items: [...state.items, action.payload],\n      };\n\n    case Types.DELETE_PRODUCT:\n      return deleteProduct(state, action.payload.id);\n\n    case Types.UPDATE_PRODUCT:\n      const index = findProductIndexById(state, action.payload.product.id);\n      state[index] = action.payload.product;\n\n      return { ...state };\n\n    default:\n      return state;\n  }\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/productFilters.ts",["599"],[],"import * as Types from '../constants/actionTypes';\n\nexport default (state = { category: '' }, action) => {\n  switch (action.type) {\n    case Types.UPDATE_PRODUCT_FILTERS:\n      return {\n        ...state,\n        ...action.payload.productFilters,\n      };\n\n    case Types.UPDATE_PRODUCT_CATEGORY:\n      const { category } = action.payload;\n      return {\n        ...state,\n        category,\n      };\n    case Types.UPDATE_RATING:\n      const { rating } = action.payload;\n      return {\n        ...state,\n        rating,\n      };\n\n    default:\n      return state;\n  }\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/quickView.ts",["600"],[],"import * as Types from '../constants/actionTypes';\n\nexport default (state = null, action) => {\n  switch (action.type) {\n\n    case Types.OPEN_QUICK_VIEW :\n      console.log('quickview active');\n      return {\n        ...action.payload.product,\n      };\n\n    case Types.CLOSE_QUICK_VIEW :\n      console.log('quickview close');\n      return null;\n\n    default:\n      return state;\n  }\n}\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/resource.ts",["601"],[],"import { deleteResource, findResourceIndexById } from '../../lib/util';\nimport * as Types from '../constants/actionTypes';\n\n// {items:[],filteredList:[]}\n\nexport default (state = { items: [] }, action) => {\n  switch (action.type) {\n    case Types.FETCHED_RESOURCE:\n      return {\n        ...state,\n        items: [...action.payload.resources],\n      };\n\n    case Types.FETCHED_MORE_RESOURCE:\n      const mergeAllResources = [...state.items, ...action.payload.resources];\n      // console.log(mergeAllResources);\n      const limit =\n        action.payload.total && mergeAllResources.length > action.payload.total\n          ? mergeAllResources.splice(0, action.payload.total)\n          : mergeAllResources;\n\n      return {\n        ...state,\n        items: [...limit],\n      };\n\n    case Types.ADD_RESOURCE:\n      return {\n        ...state,\n        items: [...state.items, action.payload],\n      };\n\n    case Types.DELETE_RESOURCE:\n      return deleteResource(state, action.payload.id);\n\n    case Types.UPDATE_RESOURCE:\n      const index = findResourceIndexById(state, action.payload.resource.id);\n      state[index] = action.payload.resource;\n\n      return { ...state };\n\n    default:\n      return state;\n  }\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/resourceFilters.ts",["602"],[],"import * as Types from '../constants/actionTypes';\n\nexport default (state = { category: '' }, action) => {\n  switch (action.type) {\n    case Types.UPDATE_RESOURCE_FILTERS:\n      return {\n        ...state,\n        ...action.payload.resourceFilters,\n      };\n\n    case Types.UPDATE_RESOURCE_CATEGORY:\n      const { category } = action.payload;\n      return {\n        ...state,\n        category,\n      };\n    case Types.UPDATE_RATING:\n      const { rating } = action.payload;\n      return {\n        ...state,\n        rating,\n      };\n\n    default:\n      return state;\n  }\n};\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/rootReducer.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/redux/reducer/wishlist.ts",["603"],[],"import * as Types from '../constants/actionTypes';\nimport { deleteProduct, findProductIndexById } from '../../lib/util';\nimport storage from '../../lib/localStorage';\n\n\nconst initialState = {\n  modal: false,\n  items: [],\n};\n\nexport default (state = initialState, action) => {\n\n  let index = null;\n\n  switch (action.type) {\n\n    case Types.OPEN_WISHLIST:\n\n      return {\n        ...state,\n        modal: true,\n      };\n\n    case Types.CLOSE_WISHLIST:\n\n      return {\n        ...state,\n        modal: false,\n      };\n\n    case Types.INIT_LOCALSTORAGE:\n\n      return {\n        ...state,\n        items: [...action.payload.wishlist],\n      };\n\n    case Types.ADD_TO_WISHLIST:\n\n      index = findProductIndexById(state.items, action.payload.product.id);\n      if (index !== -1) return state;\n\n      const items = [...state.items, action.payload.product];\n      storage.set('dokani_wishlist', items);\n\n      return {\n        ...state,\n        items,\n      };\n\n\n    case Types.DELETE_FROM_WISHLIST:\n\n      const list = deleteProduct(state.items, action.payload.productId);\n      storage.set('dokani_wishlist', list);\n\n      return {\n        ...state,\n        items: [...list],\n      };\n\n    case Types.CLEAR_WISHLIST:\n\n      storage.set('dokani_wishlist', []);\n\n      return {\n        ...state,\n        items: [],\n      };\n\n\n    default:\n      return state;\n  }\n}\n","/Users/kahboom/Projects/thetextilecode.com/src/redux/store.ts",[],[],{"ruleId":"604","severity":1,"message":"605","line":3,"column":1,"nodeType":"606","endLine":45,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":3,"column":1,"nodeType":"606","endLine":45,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":1,"column":1,"nodeType":"606","endLine":14,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":5,"column":1,"nodeType":"606","endLine":61,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":10,"column":1,"nodeType":"606","endLine":65,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":6,"column":1,"nodeType":"606","endLine":49,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":3,"column":1,"nodeType":"606","endLine":27,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":3,"column":1,"nodeType":"606","endLine":19,"endColumn":2},{"ruleId":"604","severity":1,"message":"605","line":6,"column":1,"nodeType":"606","endLine":45,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":3,"column":1,"nodeType":"606","endLine":27,"endColumn":3},{"ruleId":"604","severity":1,"message":"605","line":11,"column":1,"nodeType":"606","endLine":75,"endColumn":2},"import/no-anonymous-default-export","Assign arrow function to a variable before exporting as module default","ExportDefaultDeclaration"]