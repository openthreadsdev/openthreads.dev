/Projects/thetextilecode.com/src/components/elements/ProductTab.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/elements/ShareIcons.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/elements/SocialIcons.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/elements/Timer.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/layout/Breadcrumb.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/layout/Footer.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/layout/Header.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/layout/Layout.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/layout/Menu.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/layout/MobileMenu.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Brand.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Category.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Related.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Special.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/Thumb.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/api.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/filterProduct.ts",["495"],[],"// Filter Products By Filters\n\nexport default (productList, filters) => {\n  let filteredList = [...productList];\n\n  for (const key in filters) {\n    if (key !== 'price') {\n      if (\n        filters[key] === 'featured' ||\n        filters[key] === 'trending' ||\n        filters[key] === 'lowToHigh' ||\n        filters[key] === 'highToLow'\n      ) {\n        if (filters[key] === 'lowToHigh') {\n          filteredList = [\n            ...filteredList.sort((a, b) => {\n              if (a.price < b.price) return -1;\n              if (a.price > b.price) return 1;\n            }),\n          ];\n        } else {\n          if (filters[key] === 'highToLow') {\n            console.log('hi');\n            filteredList = [\n              ...filteredList.sort((a, b) => {\n                if (b.price < a.price) return -1;\n                if (b.price > a.price) return 1;\n              }),\n            ];\n          } else {\n            console.log('hi1');\n            filteredList = filteredList.filter(\n              (item) => item[filters[key]],\n            );\n          }\n        }\n      } else {\n        filteredList = filterByKey(filteredList, filters[key], key);\n      }\n    } else {\n      filteredList = filterByPrice(filteredList, filters[key], key);\n    }\n  }\n  return filteredList;\n};\n\n// Filter Product By Price\n\nfunction filterByPrice(filteredList, price, key) {\n  let list = [];\n\n  for (let index = 0; index < filteredList.length; index++) {\n    const product = filteredList[index];\n    const productPrice = product[key];\n\n    if (productPrice >= price.min && productPrice <= price.max) {\n      list.push(product);\n    }\n  }\n\n  return (filteredList = list);\n}\n\n// Filter Product by key size/category/brand etc\n\nfunction filterByKey(filteredList, size, key) {\n  let list = [];\n  if (!size || size.length === 0) return filteredList;\n  for (let index = 0; index < filteredList.length; index++) {\n    const product = filteredList[index];\n\n    if (size.indexOf != undefined) {\n      const isOk = size && size.indexOf(product[key]);\n      if (isOk !== -1) {\n        list.push(product);\n      }\n    }\n  }\n\n  return (filteredList = list);\n}\n","/Users/kahboom/Projects/thetextilecode.com/src/lib/localStorage.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/mdxUtils.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/outsideClick.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/searchItemsByText.ts",["496"],[],"export default (searchTerm, products) => {\n  if (!searchTerm) return products;\n\n  let list = [];\n  const words = searchTerm.toLowerCase().split(' ');\n\n  for (let index = 0; index < products.length; index++) {\n    const product = products[index];\n    const isMatched = matchWordList(product.title, words);\n    if (isMatched) list.push(product);\n  }\n\n  return list;\n}\n\nconst matchWordList = (productTitle, words) => {\n  let matched = false;\n\n  for (let index = 0; index < words.length; index++) {\n    const word = words[index];\n    let isContainWord = productTitle.toLowerCase().indexOf(word) !== -1;\n    isContainWord ? matched = true : matched = false;\n    if (!isContainWord) break;\n  }\n  return matched;\n};\n\n","/Users/kahboom/Projects/thetextilecode.com/src/lib/util.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/get-involved.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/success.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/credits.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/HomeSlider.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/resources/[slug].tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/resources/index.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/resources/resources-filter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/elements/CustomLink.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/elements/Tooltippy.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/BrandFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/CartSidebar.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/CategoryFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/CategoryResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Checkbox.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ColorFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/CompareModal.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/CompareTable.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ConditionFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Pagination.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/PriceRange.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/PriceRangeSlider.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/QuickView.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Rating.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ResourceDetails.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ResourceTab.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ResourcesFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Search.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/ShowSelect.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SidebarIcon.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SingleResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SingleResourceList.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SizeFilter.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/SortSelect.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/Tags.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/WishlistModal.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/fetchSlider.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/resources/storage-wrapper.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/FeaturedResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/sliders/RelatedResource.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/lib/filterResource.ts",["497"],[],"// Filter Resources By Filters\n\nexport default (resourceList, filters) => {\n  let filteredList = [...resourceList];\n\n  for (const key in filters) {\n    if (key !== 'price') {\n      if (\n        filters[key] === 'featured' ||\n        filters[key] === 'trending' ||\n        filters[key] === 'lowToHigh' ||\n        filters[key] === 'highToLow'\n      ) {\n        if (filters[key] === 'lowToHigh') {\n          filteredList = [\n            ...filteredList.sort((a, b) => {\n              if (a.price < b.price) return -1;\n              if (a.price > b.price) return 1;\n            }),\n          ];\n        } else {\n          if (filters[key] === 'highToLow') {\n            console.log('hi');\n            filteredList = [\n              ...filteredList.sort((a, b) => {\n                if (b.price < a.price) return -1;\n                if (b.price > a.price) return 1;\n              }),\n            ];\n          } else {\n            console.log('hi1');\n            filteredList = filteredList.filter((item) => item[filters[key]]);\n          }\n        }\n      } else {\n        filteredList = filterByKey(filteredList, filters[key], key);\n      }\n    } else {\n      filteredList = filterByPrice(filteredList, filters[key], key);\n    }\n  }\n  return filteredList;\n};\n\n// Filter Resource By Price\n\nfunction filterByPrice(filteredList, price, key) {\n  let list = [];\n\n  for (let index = 0; index < filteredList.length; index++) {\n    const resource = filteredList[index];\n    const resourcePrice = resource[key];\n\n    if (resourcePrice >= price.min && resourcePrice <= price.max) {\n      list.push(resource);\n    }\n  }\n\n  return (filteredList = list);\n}\n\n// Filter Resource by key size/category/brand etc\n\nfunction filterByKey(filteredList, size, key) {\n  let list = [];\n  if (!size || size.length === 0) return filteredList;\n  for (let index = 0; index < filteredList.length; index++) {\n    const resource = filteredList[index];\n\n    if (size.indexOf != undefined) {\n      const isOk = size && size.indexOf(resource[key]);\n      if (isOk !== -1) {\n        list.push(resource);\n      }\n    }\n  }\n\n  return (filteredList = list);\n}\n","/Users/kahboom/Projects/thetextilecode.com/src/lib/fonts.ts",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/components/elements/HomeBanner.tsx",[],[],"/Users/kahboom/Projects/thetextilecode.com/src/pages/category/[category].tsx",[],[],{"ruleId":"498","severity":1,"message":"499","line":3,"column":1,"nodeType":"500","endLine":45,"endColumn":3},{"ruleId":"498","severity":1,"message":"499","line":1,"column":1,"nodeType":"500","endLine":14,"endColumn":2},{"ruleId":"498","severity":1,"message":"499","line":3,"column":1,"nodeType":"500","endLine":43,"endColumn":3},"import/no-anonymous-default-export","Assign arrow function to a variable before exporting as module default","ExportDefaultDeclaration"]
